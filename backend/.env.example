# Database Configuration
DB_HOST=localhost
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_PORT=5432
DB_SSLMODE=disable
DB_TIMEZONE=Europe/Istanbul

# Application Configuration
APP_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Admin Configuration
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
ADMIN_ROLEID=1

# JWT Configuration
# Oturum imzalama anahtarı. En az 32 karakter olmalı ve deploy'lar arasında
# DEĞİŞMEMELİ; değişirse giriş yapmış tüm kullanıcılar çıkış yapar.
# Üretmek için: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_min_32_chars

# Mail Configuration (Resend HTTP API)
# MAIL_ENABLED=false iken mail gönderilmez, şablon stdout'a yazılır (geliştirme).
MAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=MihrimahSiir <noreply@your-domain.com>
MAIL_REPLY_TO=your@email.com
# Yeni kitap isteği bildirimlerinin gideceği adres
ADMIN_NOTIFY_EMAIL=admin@your-domain.com
# Resend ücretsiz tier ~100/gün; altında bir tavan bırakın
MAIL_DAILY_LIMIT=80

# Mail içindeki bağlantılarda kullanılan genel adres
APP_PUBLIC_URL=http://localhost:3000
# Open Library taban adresi (test için değiştirilebilir)
OPENLIBRARY_BASE_URL=https://openlibrary.org
